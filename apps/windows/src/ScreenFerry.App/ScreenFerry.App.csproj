<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for System.Windows.Forms.NotifyIcon; see docs/adr/0002-technology-stack.md. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ScreenFerry</AssemblyName>
    <RootNamespace>ScreenFerry.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScreenFerry.Core\ScreenFerry.Core.csproj" />
  </ItemGroup>
</Project>
